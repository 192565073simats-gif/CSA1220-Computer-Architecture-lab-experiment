LDA 2000H       ; Load first number into accumulator
                MOV B, A        ; Store first number in register B

                LDA 2001H       ; Load second number into accumulator
                STA 2000H       ; Store second number at 2000H (swap done for 1st location)

                MOV A, B        ; Retrieve original first number from B
                STA 2001H       ; Store first number at 2001H (swap done for 2nd location)

                HLT             ; Stop execution
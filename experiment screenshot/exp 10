LDA 2000H       ; Load first number into accumulator
                MOV B, A        ; Store it in register B

                LDA 2001H       ; Load second number into accumulator
                CMP B           ; Compare A (2nd number) with B (1st number)

                JC STORE        ; If A < B (Carry set), A is smaller, go to STORE
                MOV A, B        ; Else, B (1st number) is smaller/equal, move it to A

STORE:          STA 2002H       ; Store the smallest number at 2002H

                HLT             ; Stop execution